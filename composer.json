{
    "name": "mikepagedev/filament-portfolio",
    "description": "Portfolio projects and case studies for Filament panels.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.9"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "MikePageDev\\FilamentPortfolio\\": "src/",
            "MikePageDev\\FilamentPortfolio\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MikePageDev\\FilamentPortfolio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MikePageDev\\FilamentPortfolio\\FilamentPortfolioServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "lint": "pint --test",
        "check": [
            "@test",
            "@stan",
            "@lint"
        ]
    },
    "minimum-stability": "stable"
}
